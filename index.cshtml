@{
    // Fake Model for testing
    var Model = new List<dynamic> {
        new { PG_GUID = "1", PG_IMAGE = "images/photo1.jpg", PG_TITLE = "Beautiful Sunset" },
        new { PG_GUID = "2", PG_IMAGE = "images/photo2.jpg", PG_TITLE = "Mountain View" },
        new { PG_GUID = "3", PG_IMAGE = "images/photo3.jpg", PG_TITLE = "Ocean Waves" }
    };
    
    Func<string, string> Localizer = (string key) => key == "Home" ? "Home" : "Photo";
}

<div class="breadcrumb-wrapper">
    <div class="breadcrumb-line">
        <a href="/">@Localizer["Home"]</a>
        <span>›</span>
        <span class="current">@Localizer["Photo"]</span>
    </div>
</div>

<div class="fotogallery">
    <div class="gallery-grid">
        @foreach (var imagePath in Model)
        {
            <a asp-action="Details" asp-route-guid="@imagePath.PG_GUID" class="gallery-item-link">
        <div class="gallery-item"
             data-subgallery="gallery-1"
             data-gallery-title="Gallery 1">
            <div class="img-wrapper">
                        <img src="~/@imagePath.PG_IMAGE" alt="Gallery Image" />
                        <div class="magnify-icon">
                    <i class="fa-regular fa-images"></i>
                </div>
                <div class="overlay"></div>
            </div>
            <div class="gallery-item-content">
                        <p>@imagePath.PG_TITLE</p>
            </div>            
        </div>
        
        </a>
        }
    </div>
</div>


<div id="lightbox-modal" class="lightbox-modal">
    <div class="lightbox-content">
        <div class="lightbox-header">
            <div class="lightbox-image-info">
                <span id="current-img-num">1</span> of <span id="total-img">1</span>
            </div>
            <div class="lightbox-controls">
                <button class="lightbox-btn zoom-in" title="Zoom In">
                    <i class="fas fa-search-plus"></i>
                </button>
                <button class="lightbox-btn zoom-out" title="Zoom Out">
                    <i class="fas fa-search-minus"></i>
                </button>
                <button class="lightbox-btn download-btn" title="Download">
                    <i class="fas fa-download"></i>
                </button>
                <button class="lightbox-btn close-btn" title="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>
        <div class="lightbox-body">
            <img id="lightbox-img" src="" alt="">
        </div>
        <div class="lightbox-nav">
            <button class="lightbox-nav-btn prev-btn" title="Previous Image">
                <i class="fas fa-chevron-left"></i>
            </button>
            <button class="lightbox-nav-btn next-btn" title="Next Image">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>
        <div class="lightbox-footer">
            <p id="lightbox-caption"></p>
        </div>
    </div>
</div>

<div id="subgallery-modal" class="subgallery-modal">
    <div class="subgallery-content">
        <div class="subgallery-header">
            <h2 class="subgallery-title">Gallery</h2>
            <button class="subgallery-close-btn">
                <i class="fas fa-times"></i> Close
            </button>
        </div>
        <div class="subgallery-body">
            <div class="subgallery-grid" id="subgallery-grid">
                <!-- Sub-gallery items will be added here by JavaScript -->
            </div>
        </div>
    </div>
</div>

